// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS — 13 Enums
// المرجع: DECISIONS.md
// ============================================

/// دور المستخدم
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
  DELIVERY
}

/// مصدر الطلب
enum OrderSource {
  ONLINE    // من الموقع الإلكتروني
  IN_STORE  // من المحل الحقيقي (بمسح QR)
}

/// حالة حساب السائق
enum DeliveryPersonStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// نوع محاولة التوصيل
enum DeliveryAttemptType {
  DELIVERED   // تم التسليم
  DEFERRED    // تأجيل
  REJECTED    // رفض العميل
  RETURNED    // إرجاع
}

/// فئة الصلاحية
enum PermissionCategory {
  ORDERS
  SHIPMENT
  DELIVERY
  SELLER
  ADMIN
  SYSTEM
}

/// حالة البائع
enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

/// حالة المنتج
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// نوع حركة المخزون
enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  RETURN
  RESERVE
  UNRESERVE
}

/// مصدر حركة المخزون
enum ReferenceType {
  ORDER
  MANUAL
  SYSTEM
  RETURN
}

/// حالة الطلب
enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

/// طريقة الدفع
enum PaymentMethod {
  COD
}

/// حالة الدفع
enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

/// حالة الحجز
enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

/// نوع الكوبون
enum CouponType {
  PERCENTAGE
  FIXED
}

/// حالة طلب الإرجاع
enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

/// نوع الإشعار
enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_RECEIVED
  SHIPPING_UPDATED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  SELLER_ORDER_RECEIVED
  SELLER_PAYOUT_READY
  SELLER_PAYOUT_SENT
  SELLER_PRODUCT_LOW_STOCK
  SELLER_DOCUMENT_APPROVED
  SELLER_DOCUMENT_REJECTED
  SELLER_PERFORMANCE_WARNING
  SELLER_SUSPENDED
  SELLER_VERIFIED
  SELLER_PRODUCT_EDITED
  SELLER_PRODUCT_NEEDS_REVIEW
  SELLER_NEW_REGISTRATION
  REVIEW_SUBMITTED
}

/// نوع العملية الم​دقَ​قة
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  STATUS_CHANGE
  PERMISSION_CHANGE
  PAYMENT_CHANGE
  STOCK_ADJUSTMENT
  QR_SCAN
  SHIPMENT_CREATE
  SHIPMENT_UPDATE
  DELIVERY_ASSIGN
  DELIVERY_ACTION
}

/// نوع حركة نقاط الولاء
enum LoyaltyTransactionType {
  EARN          // نقاط من طلب
  REVOKE        // سحب بسبب إرجاع
  BONUS         // نقاط إضافية
  ADMIN_ADJUST  // تعديل يدوي
}

/// حالة مكافأة الولاء
enum LoyaltyRewardStatus {
  PENDING       // فتحها، بانتظار اختيار الأدمن
  PROCESSING    // الأدمن بدأ التجهيز
  SHIPPED       // تم الشحن
  DELIVERED     // تم التسليم
  CANCELLED     // ملغى
}

// ============================================
// GROUP 1 — IDENTITY
// User, Address, Session, Seller
// ============================================

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  referralCode String    @unique @default(cuid())
  referredById Int?
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  addresses      Address[]
  seller         Seller?
  cart           Cart?
  orders         Order[]
  couponUsages   CouponUsage[]
  returnRequests ReturnRequest[]
  reviews        Review[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  loyaltyAccount LoyaltyAccount?
  sessions       Session[]
  passwordResetTokens PasswordResetToken[]

  referredBy         User?             @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referralsGiven     User[]            @relation("UserReferrals")
  referralAsReferrer Referral?         @relation("ReferralAsReferrer")
  referralAsReferred Referral?         @relation("ReferralAsReferred")
  deliveryPerson     DeliveryPerson?
  userPermissions    UserPermission[]
  favorites          Favorite[]

  @@index([email])
  @@index([deletedAt])
}

model Address {
  id         Int       @id @default(autoincrement())
  userId     Int
  fullName   String
  phone      String
  country    String
  city       String
  street     String
  postalCode String?
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([deletedAt])
}

model Session {
  id            String    @id @default(cuid())
  userId        Int
  tokenHash     String    @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Seller {
  id                     Int          @id @default(autoincrement())
  userId                 Int          @unique
  storeName              String
  slug                   String       @unique
  description            String?
  logo                   String?
  status                 SellerStatus @default(PENDING)

  commissionRateOverride Decimal?     @db.Decimal(5, 4)

  totalOrders            Int          @default(0)
  totalRevenue           Decimal      @default(0) @db.Decimal(12, 2)
  totalCommission        Decimal      @default(0) @db.Decimal(12, 2)
  acceptanceRate         Decimal      @default(0) @db.Decimal(5, 4)
  cancellationRate       Decimal      @default(0) @db.Decimal(5, 4)
  codRejectionRate       Decimal      @default(0) @db.Decimal(5, 4)
  returnRate             Decimal      @default(0) @db.Decimal(5, 4)
  avgRating              Decimal      @default(0) @db.Decimal(3, 2)
  avgProcessingHours     Decimal      @default(0) @db.Decimal(6, 2)
  lastPerformanceUpdate  DateTime?

  isVerified             Boolean      @default(false)
  verifiedAt             DateTime?
  verifiedById           Int?
  isFeatured             Boolean      @default(false)

  city                   String?
  region                 String?

  notificationPreferences Json?
  termsAcceptedAt        DateTime?
  termsVersion           String?

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  products             Product[]
  orders               Order[]
  bankAccounts         SellerBankAccount[]
  documents            SellerDocument[]
  performanceSnapshots SellerPerformanceSnapshot[]
  payouts              SellerPayout[]
  editLogs             ProductEditLog[]
  attributeValues      CategoryAttributeValue[]

  @@index([status])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([isVerified])
}

// ============================================
// GROUP 2 — CATALOG & INVENTORY
// Category, Product, ProductImage, 
// ProductOption, ProductOptionValue, 
// ProductVariant, ProductVariantOptionValue,
// Inventory, InventoryMovement
// ============================================

model Category {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique
  parentId       Int?
  image          String?
  isActive       Boolean   @default(true)
  order          Int       @default(0)
  commissionRate Decimal?  @db.Decimal(5, 4)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent     Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]          @relation("CategoryHierarchy")
  products   Product[]
  attributes CategoryAttribute[]

  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
}

model Product {
  id          Int           @id @default(autoincrement())
  productCode String        @unique @default(uuid())
  sellerId    Int
  categoryId  Int
  name        String
  slug        String
  description String?
  brand       String?
  badge       String?
  rating      Float         @default(0)
  reviewsCount Int          @default(0)
  sold        Int           @default(0)
  freeShipping Boolean      @default(false)
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  isNew       Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  options  ProductOption[]
  variants ProductVariant[]
  orderItems OrderItem[]
  reviews  Review[]
  editLogs ProductEditLog[]
  favorites  Favorite[]

  @@unique([sellerId, slug])
  @@index([slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  order     Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductOption {
  id                  Int      @id @default(autoincrement())
  productId           Int
  categoryAttributeId Int?
  name                String
  order               Int      @default(0)

  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@index([categoryAttributeId])
}

model ProductOptionValue {
  id       Int    @id @default(autoincrement())
  optionId Int
  value    String
  order    Int    @default(0)

  option   ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  sellerId      Int
  sku           String
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  optionsHash   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product        Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   ProductVariantOptionValue[]
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reservationItems ReservationItem[]

  @@unique([productId, optionsHash])
  @@unique([sellerId, sku])
  @@index([productId])
  @@index([sellerId])
  @@index([sku])
}

model ProductVariantOptionValue {
  id            Int @id @default(autoincrement())
  variantId     Int
  optionValueId Int

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
}

model Inventory {
  id                Int      @id @default(autoincrement())
  variantId         Int      @unique
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([variantId])
}

model InventoryMovement {
  id                      BigInt        @id @default(autoincrement())
  inventoryId             Int
  type                    MovementType
  beforeQuantity          Int
  afterQuantity           Int
  quantityChange          Int
  beforeReserved          Int
  afterReserved           Int
  reservedChange          Int
  reason                  String?
  referenceType           ReferenceType?
  referenceId             BigInt?
  performedById           Int?
  createdAt               DateTime      @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([referenceType, referenceId])
  @@index([performedById])
  @@index([createdAt])
}

// ============================================
// GROUP 3 — CART & ORDERS
// Cart, CartItem, Order, OrderItem, 
// OrderStatusHistory, Reservation, ReservationItem,
// IdempotencyKey, OrderSequence
// ============================================

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                      Int           @id @default(autoincrement())
  orderNumber             String        @unique
  userId                  Int
  sellerId                Int?
  source                  OrderSource   @default(ONLINE)
  createdBySellerId       Int?
  deliveryToken           String?       @unique @default(uuid())
  deliveryPersonId        Int?
  assignedAt              DateTime?
  status                  OrderStatus   @default(NEW)
  paymentMethod           PaymentMethod @default(COD)
  paymentStatus           PaymentStatus @default(PENDING)
  subtotal                Decimal       @db.Decimal(10, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(10, 2)
  shippingCost            Decimal       @db.Decimal(10, 2)
  discount                Decimal       @default(0) @db.Decimal(10, 2)
  total                   Decimal       @db.Decimal(10, 2)
  commission              Decimal?      @db.Decimal(10, 2)
  refundedCommission      Decimal       @default(0) @db.Decimal(10, 2)
  sellerPayout            Decimal?      @db.Decimal(10, 2)
  refundedAmount          Decimal       @default(0) @db.Decimal(10, 2)
  shippingRefunded        Boolean       @default(false)
  shippingAddressSnapshot Json
  customerSnapshot        Json
  shippingZoneId          Int?
  notes                   String?
  sellerNotes             String?
  loyaltyPointsAwarded    Int           @default(0)
  loyaltyPointsRevoked    Int           @default(0)
  loyaltyAwardedAt        DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller           Seller?              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  deliveryPerson   DeliveryPerson?      @relation("OrderDeliveryPerson", fields: [deliveryPersonId], references: [id], onDelete: SetNull)
  deliveryAttempts DeliveryAttempt[]
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  reservation      Reservation?
  couponUsage      CouponUsage?
  returnRequests   ReturnRequest[]
  reviews          Review[]
  shippingZone     ShippingZone?        @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  costs            CostRecord[]

  @@index([userId])
  @@index([sellerId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([sellerId, status])
  @@index([sellerId, createdAt])
  @@index([source])
  @@index([sellerId, source])
  @@index([deliveryPersonId])
  @@index([deliveryPersonId, status])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  variantId   Int?
  productName String
  variantName String?
  sku         String
  imageUrl    String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(10, 2)

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews   Review[]
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          Int         @id @default(autoincrement())
  orderId     Int
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById Int
  note        String?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Reservation {
  id            Int               @id @default(autoincrement())
  orderId       Int               @unique
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime          @default(now())

  order Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReservationItem[]

  @@index([status])
  @@index([expiresAt])
}

model ReservationItem {
  id            Int @id @default(autoincrement())
  reservationId Int
  variantId     Int
  quantity      Int

  reservation Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([reservationId, variantId])
  @@index([reservationId])
  @@index([variantId])
}

model IdempotencyKey {
  id          Int      @id @default(autoincrement())
  key         String
  userId      Int
  endpoint    String
  requestHash String
  response    Json?
  statusCode  Int?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@index([userId, endpoint])
}

model OrderSequence {
  year       Int @id
  lastNumber Int @default(0)
}

// ============================================
// GROUP 4 — SHIPPING & COUPONS
// ShippingZone, ShippingZoneCity, 
// Coupon, CouponUsage
// ============================================

model ShippingZone {
  id            Int      @id @default(autoincrement())
  name          String
  cost          Decimal  @db.Decimal(10, 2)
  freeThreshold Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cities ShippingZoneCity[]
  orders Order[]

  @@index([isActive])
}

model ShippingZoneCity {
  id             Int    @id @default(autoincrement())
  shippingZoneId Int
  city           String
  cityNormalized String @unique

  shippingZone ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@index([shippingZoneId])
  @@index([cityNormalized])
}

model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  maxUses        Int?
  maxUsesPerUser Int        @default(1)
  usedCount      Int        @default(0)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  userId    Int
  orderId   Int      @unique
  discount  Decimal  @db.Decimal(10, 2)
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
  @@index([couponId])
}

// ============================================
// GROUP 5 — RETURNS & REVIEWS
// ReturnRequest, ReturnItem, Review
// ============================================

model ReturnRequest {
  id            Int          @id @default(autoincrement())
  orderId       Int
  userId        Int
  status        ReturnStatus @default(PENDING)
  reason        String
  adminNote     String?
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  processedById Int?

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items ReturnItem[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model ReturnItem {
  id               Int     @id @default(autoincrement())
  returnId         Int
  orderItemId      Int
  quantity         Int
  condition        String?
  refundAmount     Decimal @default(0) @db.Decimal(10, 2)
  isLastAdjustment Boolean @default(false)

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     Int
  orderId    Int
  orderItemId Int
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([orderItemId])
  @@index([deletedAt])
}

// ============================================
// GROUP 6 — SYSTEM
// Notification, AuditLog
// ============================================

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  link      String?
  metadata  Json?
  category  String?
  severity  String?          @default("INFO")
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([category])
  @@index([severity])
  @@index([userId, category, isRead])
}

model AuditLog {
  id        BigInt       @id @default(autoincrement())
  userId    Int?
  action    AuditAction
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// SECTION 77 — Multi-Vendor Foundation
// ============================================

enum DocumentType {
  CIN
  PASSPORT
  ICE
  RC
  IF
  BANK_STATEMENT
  ADDRESS_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum CostType {
  SHIPPING
  COD_REFUSAL
  RETURN_SHIPPING
  COMMISSION
  REFUND
  ADJUSTMENT
}

enum CostBearer {
  SELLER
  PLATFORM
  CUSTOMER
  SHARED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model SellerBankAccount {
  id                  Int                    @id @default(autoincrement())
  sellerId            Int
  bankName            String
  
  // ═══ مقنّعة للعرض ═══
  accountHolderMasked String
  ibanMasked          String
  ibanLast4           String
  ribMasked           String?
  
  // ═══ مشفّرة (AES-256-GCM) ═══
  accountHolderEnc    Bytes
  ibanEnc             Bytes
  ribEnc              Bytes?
  
  // ═══ للتحقق من التكرار ═══
  ibanHash            String   @unique
  ribHash             String?
  
  // ═══ الحقول الجديدة ═══
  businessName        String?
  accountType         BankAccountType         @default(PERSONAL)
  currency            String                 @default("MAD")
  
  // ═══ حالة التحقق ═══
  verificationStatus  BankAccountVerification @default(PENDING)
  verifiedAt          DateTime?
  verifiedById        Int?
  rejectionReason     String?
  
  // ═══ الحالة ═══
  isDefault           Boolean                @default(false)
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  @@index([sellerId])
  @@index([sellerId, isDefault])
  @@index([sellerId, isActive])
  @@index([verificationStatus])
}

enum BankAccountType {
  PERSONAL
  BUSINESS
}

enum BankAccountVerification {
  PENDING
  VERIFIED
  REJECTED
}

model SellerDocument {
  id              Int            @id @default(autoincrement())
  sellerId        Int
  type            DocumentType
  status          DocumentStatus @default(PENDING)
  storageKey      String         @unique
  mimeType        String
  sizeBytes       Int
  checksum        String
  reviewedAt      DateTime?
  reviewedById    Int?
  rejectionReason String?
  notes           String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
}

model SystemPolicy {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

model CostRecord {
  id                  Int          @id @default(autoincrement())
  orderId             Int?
  type                CostType
  amount              Decimal      @db.Decimal(10, 2)
  currency            String       @default("MAD")
  bearer              CostBearer
  policyKey           String?
  policyValueSnapshot Json?
  reason              String?
  createdAt           DateTime     @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@index([bearer])
  @@index([createdAt])
}

model SellerPerformanceSnapshot {
  id                 Int      @id @default(autoincrement())
  sellerId           Int
  periodStart        DateTime
  periodEnd          DateTime
  ordersTotal        Int
  ordersAccepted     Int
  ordersCancelled    Int
  ordersDelivered    Int
  ordersRefusedCOD   Int
  ordersReturned     Int
  revenue            Decimal  @db.Decimal(12, 2)
  commission         Decimal  @db.Decimal(12, 2)
  avgRating          Decimal  @db.Decimal(3, 2)
  avgProcessingHours Decimal  @db.Decimal(6, 2)
  createdAt          DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, periodStart, periodEnd])
  @@index([sellerId, periodEnd])
}

model SellerPayout {
  id             Int          @id @default(autoincrement())
  sellerId       Int
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("MAD")
  status         PayoutStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  orderCount     Int
  bankAccountId  Int?
  transactionRef String?
  notes          String?
  processedAt    DateTime?
  processedById  Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model MultiVendorTriggerMetrics {
  id                   Int      @id @default(autoincrement())
  periodStart          DateTime
  periodEnd            DateTime
  activeSellers        Int
  multiSellerOrders    Int
  totalOrders          Int
  multiSellerRatio     Decimal  @db.Decimal(5, 4)
  customerComplaints   Int
  cancelledMultiOrders Int
  returnMultiOrders    Int
  totalShippingCost    Decimal  @db.Decimal(12, 2)
  avgShippingPerOrder  Decimal  @db.Decimal(10, 2)
  createdAt            DateTime @default(now())

  @@index([periodEnd])
}

// ═══════════════════════════════════════════
// Product Edit Log — سجل تعديلات المنتجات
// ═══════════════════════════════════════════
model ProductEditLog {
  id                 Int      @id @default(autoincrement())
  productId          Int
  sellerId           Int
  changedFields      Json     // ["الاسم", "الصور", "السعر"]
  oldValues          Json     // { name: "x", price: 100 }
  newValues          Json     // { name: "y", price: 50 }
  requiresReapproval Boolean  @default(false)
  reason             String?  // "تعديل حساس" / "تعديل سعر تجاوز الحد"
  reviewedAt         DateTime?
  reviewedById       Int?
  reviewAction       String?  // "approved" / "rejected"
  createdAt          DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@index([createdAt])
  @@index([requiresReapproval])
  @@index([reviewedAt])
}

// ============================================
// SECTION 80 — LOYALTY SYSTEM
// ============================================

// ═══ الإعدادات العامة ═══
model LoyaltySettings {
  id             Int      @id @default(1)
  isEnabled      Boolean  @default(true)
  pointsPer100DH Int      @default(5)
  description    String?
  updatedAt      DateTime @updatedAt
}

// ═══ حساب الولاء لكل مستخدم ═══
model LoyaltyAccount {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  balance      Int      @default(0)
  totalEarned  Int      @default(0)
  totalRevoked Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  unlocks      LoyaltyTierUnlock[]
  rewards      LoyaltyReward[]

  @@index([balance])
}

// ═══ سجل حركات النقاط (Ledger) ═══
model LoyaltyTransaction {
  id            Int                    @id @default(autoincrement())
  accountId     Int
  type          LoyaltyTransactionType
  points        Int
  balanceBefore Int
  balanceAfter  Int
  reason        String?
  orderId       Int?
  adminId       Int?
  metadata      Json?
  createdAt     DateTime               @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// ═══ مستويات المكافآت ═══
model LoyaltyTier {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  description    String?
  icon           String?
  requiredPoints Int
  rewardValueMin Decimal? @db.Decimal(10, 2)
  rewardValueMax Decimal? @db.Decimal(10, 2)
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unlocks      LoyaltyTierUnlock[]
  rewards      LoyaltyReward[]
  giftProducts LoyaltyGiftProduct[]

  @@index([requiredPoints])
  @@index([isActive])
}

// ═══ متى فُتح كل مستوى ═══
model LoyaltyTierUnlock {
  id         Int      @id @default(autoincrement())
  accountId  Int
  tierId     Int
  unlockedAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tier    LoyaltyTier    @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([accountId, tierId])
  @@index([accountId])
  @@index([tierId])
}

// ═══ فئات الهدايا (ملابس، أحذية...) ═══
model LoyaltyRewardCategory {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  name     String
  icon     String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  giftProducts LoyaltyGiftProduct[]
  rewards      LoyaltyReward[]

  @@index([isActive])
}

// ═══ مخزون الهدايا (مستقل تماماً) ═══
model LoyaltyGiftProduct {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  imageUrl      String?
  tierId        Int
  categoryId    Int
  costPrice     Decimal  @db.Decimal(10, 2)
  salePrice     Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tier     LoyaltyTier           @relation(fields: [tierId], references: [id], onDelete: Restrict)
  category LoyaltyRewardCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rewards  LoyaltyReward[]

  @@index([tierId])
  @@index([categoryId])
  @@index([isActive])
}

// ═══ المكافآت المفتوحة ═══
model LoyaltyReward {
  id            Int                 @id @default(autoincrement())
  accountId     Int
  tierId        Int
  categoryId    Int?
  giftProductId Int?
  status        LoyaltyRewardStatus @default(PENDING)
  adminNote     String?
  deliveredAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  account     LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tier        LoyaltyTier            @relation(fields: [tierId], references: [id], onDelete: Restrict)
  category    LoyaltyRewardCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  giftProduct LoyaltyGiftProduct?    @relation(fields: [giftProductId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([tierId])
  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// DYNAMIC ATTRIBUTES SYSTEM
// ═══════════════════════════════════════════

enum AttributeValueStatus {
  PENDING
  APPROVED
  REJECTED
}

model CategoryAttribute {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  name          String   // "المقاس", "اللون", "الخامة"
  slug          String   // "size", "color", "material"
  type          String   @default("select") // select | color | number | text
  isVariantAxis Boolean  @default(true)     // يشارك في توليد variants
  isRequired    Boolean  @default(false)
  allowCustom   Boolean  @default(false)    // هل يمكن إضافة قيم مخصصة؟
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   CategoryAttributeValue[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
}

model CategoryAttributeValue {
  id          Int      @id @default(autoincrement())
  attributeId Int
  value       String
  slug        String
  colorHex    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?

  // ═══ جديد: نظام الموافقة ═══
  status          AttributeValueStatus @default(APPROVED)
  sellerId        Int?                 // null = قيمة عامة (من الأدمن)
  reviewedAt      DateTime?
  reviewedById    Int?
  rejectionReason String?

  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  seller    Seller?           @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@index([isActive])
  @@index([status])
  @@index([sellerId])
  @@index([attributeId, status])
}

// ═══════════════════════════════════════════
// FAVORITES
// ═══════════════════════════════════════════
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════
// SECTION 82 — REFERRAL SYSTEM
// ═══════════════════════════════════════════

model Referral {
  id             Int       @id @default(autoincrement())
  referrerId     Int       @unique
  referredId     Int       @unique
  createdAt      DateTime  @default(now())

  firstOrderId   Int?
  firstOrderAt   DateTime?
  pointsAwarded  Int       @default(0)
  rewardedAt     DateTime?

  referrer User @relation("ReferralAsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralAsReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredId])
  @@index([rewardedAt])
}

// ═══════════════════════════════════════════
// SECTION 83 — DELIVERY PERSON SYSTEM
// ═══════════════════════════════════════════

model DeliveryPerson {
  id                   Int                    @id @default(autoincrement())
  userId               Int                    @unique
  city                 String
  phone                String
  vehicleType          String?
  status               DeliveryPersonStatus   @default(ACTIVE)
  notes                String?
  totalDeliveries      Int                    @default(0)
  successfulDeliveries Int                    @default(0)
  failedDeliveries     Int                    @default(0)
  returnCount          Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedOrders    Order[]            @relation("OrderDeliveryPerson")
  deliveryAttempts  DeliveryAttempt[]

  @@index([status])
  @@index([city])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════
// SECTION 84 — DELIVERY ATTEMPTS LOG
// ═══════════════════════════════════════════

model DeliveryAttempt {
  id               Int                 @id @default(autoincrement())
  orderId          Int
  deliveryPersonId Int
  type             DeliveryAttemptType
  reason           String?
  createdAt        DateTime            @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deliveryPersonId])
  @@index([type])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// SECTION 85 — PERMISSIONS SYSTEM
// ═══════════════════════════════════════════

/// الصلاحية الواحدة — مثل: CREATE_SHIPMENT
model Permission {
  id          Int                @id @default(autoincrement())
  key         String             @unique
  name        String
  description String?
  category    PermissionCategory
  createdAt   DateTime           @default(now())

  userPermissions UserPermission[]

  @@index([category])
}

/// منح صلاحية لمستخدم معين
model UserPermission {
  id            Int      @id @default(autoincrement())
  userId        Int
  permissionId  Int
  grantedAt     DateTime @default(now())
  grantedById   Int?
  revokedAt     DateTime?
  notes         String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([userId, revokedAt])
}