  WAITING_FOR_ITEMS
  READY
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  POSTPONED
  REFUSED
  RETURNED
  CANCELLED
}

/// فئة الصلاحية
enum PermissionCategory {
  ORDERS
  SHIPMENT
  DELIVERY
  SELLER
  ADMIN
  SYSTEM
}

/// حالة البائع
enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

/// حالة المنتج
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// نوع حركة المخزون
enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  RETURN
  RESERVE
  UNRESERVE
}

/// مصدر حركة المخزون
enum ReferenceType {
  ORDER
  MANUAL
  SYSTEM
  RETURN
}

/// حالة الطلب
enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  RETURNED
}

/// طريقة الدفع
enum PaymentMethod {
  COD
}

/// حالة الدفع
enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

/// حالة الحجز
enum ReservationStatus {
