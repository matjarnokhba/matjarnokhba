# ═══════════════════════════════════════════════════════════════
# متجر نخبة — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم الحقيقية
# لا تُرفع .env الحقيقي على GitHub أبدًا
# ═══════════════════════════════════════════════════════════════

# ─── قاعدة البيانات (Neon PostgreSQL) ───
# احصل عليها من https://console.neon.tech → Project → Connection Details
# الصيغة: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=""

# ─── الموقع (يُستخدم في روابط البريد + SEO) ───
# إلزامي في production — بدونه ستكون روابط التحقق في البريد غير صالحة
# مثال: https://matjarnokhba.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Google OAuth (تسجيل الدخول بـ Google) ───
# احصل عليها من https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── البريد الإلكتروني (SMTP Gmail) ───
# SMTP_PASSWORD هو App Password من Gmail (16 حرفًا) — ليس كلمة مرور الحساب
# لإنشاء: https://myaccount.google.com/apppasswords
SMTP_EMAIL=""
SMTP_PASSWORD=""

# ─── Rate Limiting (Upstash Redis) ───
# اختياري — بدونه يُستخدم rate limit in-memory (غير موثوق في multi-instance)
# احصل عليها من https://console.upstash.com
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ─── تشفير بيانات البائعين (IBAN، مستندات) ───
# مفتاح 32-بايت بصيغة base64 — لا تغيّره بعد التشغيل وإلا ستفقد القدرة على فك التشفير
# توليد: openssl rand -base64 32
SELLER_DATA_KEY=""

# ─── مهام Cron (Vercel) ───
# سلسلة عشوائية طويلة — تُرسل مع Authorization: Bearer في كل cron request
# توليد: openssl rand -hex 32
CRON_SECRET=""